{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "options": {
        "timeout": 120000,
        "setCacheKey": true
      }
    }
  },
  "plugin": [
    "oh-my-opencode-slim",
    "@tarquinen/opencode-dcp@latest",
    "./plugins/validation.ts",
    "./plugins/autoskill.ts",
    "./plugins/strip-cache-key.ts",
    "./plugins/delegation.ts",
    "./plugins/ponytail.mjs",
    "./plugins/caveman/plugin.js"
  ],
  "instructions": ["./AGENTS.md"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "headers": {
        "CONTEXT7_API_KEY": "{env:CONTEXT7_API_KEY}"
      },
      "enabled": false
    },
    "brave-search": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-brave-search"],
      "enabled": false,
      "environment": {
        "BRAVE_API_KEY": "{env:BRAVE_API_KEY}"
      }
    }
  },
  "agent": {
    "autoskill": {
      "description": "Scan project tech stack and install matching AI skills to .opencode/skills/",
      "mode": "subagent",
      "permission": { "read": "allow", "edit": "allow", "task": "deny", "subtask": "deny" },
      "prompt": "Run `node ~/.config/opencode/scripts/autoskills-bridge.mjs --install` in the current project directory to detect technologies and install matching AI skills. Report what technologies were detected and which skills were installed."
    },
    "fixer": {
      "description": "Fast execution specialist for well-defined tasks, which empowers orchestrator with parallel, speedy executions",
      "mode": "subagent",
      "permission": {
        "write": "allow",
        "edit": "allow",
        "bash": { "*": "allow" },
        "task": "deny",
        "subtask": "deny"
      }
    },
    "designer": {
      "description": "UI/UX specialist for intentional, polished experiences",
      "mode": "subagent",
      "permission": {
        "write": "allow",
        "edit": "allow",
        "task": "deny",
        "subtask": "deny"
      }
    },
    "refactor": {
      "permission": {
        "task": "deny",
        "subtask": "deny"
      }
    },
    "explorer": {
      "permission": {
        "task": "deny",
        "subtask": "deny"
      }
    },
    "librarian": {
      "permission": {
        "task": "deny",
        "subtask": "deny"
      }
    },
    "oracle": {
      "permission": {
        "task": "deny",
        "subtask": "deny"
      }
    },
    "observer": {
      "permission": {
        "task": "deny",
        "subtask": "deny"
      }
    },
    "validator": {
      "permission": {
        "task": "deny",
        "subtask": "deny"
      }
    }
  },
  "permission": {
    "external_directory": "allow",
    "write": "allow",
    "edit": "allow",
    "bash": {
      "*": "ask",
      "git *": "allow",
      "ls": "allow",
      "mkdir *": "allow",
      "which *": "allow",
      "ls *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "cat *": "allow",
      "echo *": "allow",
      "rtk *": "allow",
      "rm *": "deny",
      "rm": "deny",
      "npm *": "deny",
      "npm": "deny"
    }
  },
  "lsp": false,

  "command": {
    "documenter": {
      "description": "Generate comprehensive project documentation using Diátaxis framework, Mermaid diagrams, and structured formats",
      "agent": "documenter",
      "template": "Act as a documentation expert. Auto-load ALL documentation skills at startup via skill(), then use them to generate comprehensive documentation for this project."
    },
    "refactor": {
      "description": "Surgical code refactoring to improve maintainability without changing behavior",
      "agent": "refactor",
      "template": "Act as a refactoring expert. Load the refactor skill via skill(\"refactor\") and improve code maintainability without changing behavior."
    }
  }
}
